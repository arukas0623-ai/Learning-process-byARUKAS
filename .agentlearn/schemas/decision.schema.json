{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentlearn/decision.schema.json",
  "title": "AgentLearn Decision Memory",
  "type": "object",
  "required": ["id", "decision", "reason", "status", "timestamp"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "alternatives_rejected": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["ACTIVE", "RETIRED", "SUPERSEDED"]},
    "timestamp": {"type": "string", "format": "date"}
  }
}
