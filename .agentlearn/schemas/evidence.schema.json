{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentlearn/evidence.schema.json",
  "title": "AgentLearn Evidence",
  "type": "object",
  "required": ["id", "claim", "evidence", "confidence", "timestamp"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "skill": {"type": "string"},
    "claim": {"type": "string", "minLength": 1},
    "assessment": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "timestamp": {"type": "string", "format": "date"},
    "verification": {"type": "string"},
    "status": {"enum": ["UNKNOWN", "HYPOTHESIS", "VERIFIED"]}
  }
}
