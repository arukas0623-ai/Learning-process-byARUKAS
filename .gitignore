# Python runtime noise.
__pycache__/
*.py[cod]

# User-owned state must stay outside the public framework tree.
/private/
/examples/personal-learning/

# AgentLearn runtime state contains personal learner data and must never be published.
/.agentlearn/state/*
!/.agentlearn/state/
!/.agentlearn/state/schema.json
/examples/competitive-programming/initial-learner-state.json
/examples/competitive-programming/baseline-assessment.json

# AgentLearn private personal instance: never publish learner identity or history.
/.agentlearn-private/

# Common learner-state filenames (public templates use .example suffixes).
**/learner.md
**/constraints.md
**/competencies.json
**/items.json

# Runtime evidence, logs and snapshots are instance data, not Core.
**/logs/*
!**/logs/.gitkeep
**/evidence/*
!**/evidence/README.md
**/snapshots/*
!**/snapshots/README.md

# Local-only files may contain absolute paths or private settings.
*.local.md
*.local.json
*.private.md
*.private.json
.env
.env.*
